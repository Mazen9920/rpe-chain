{
  "name": "rpe-chain-backend",
  "version": "1.0.0",
  "description": "RPE Chain Supply OS — Backend API (FIFO ledger, procurement, fulfillment)",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force --skip-seed && node prisma/seed.js",
    "db:studio": "prisma studio",
    "test:smoke": "bash scripts/run-all-tests.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@sentry/node": "^10.53.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3",
    "prisma": "^5.14.0"
  }
}
