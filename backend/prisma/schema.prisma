// RPE Chain — Supply OS
// Data model derived from Master Plan v1.0 (May 2026)
// Design principles: append-only ledgers, soft deletes, multi-tenant ready,
// UTC timestamps, optimistic locking on hot rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & Access ────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(READ_ONLY)
  isActive  Boolean   @default(true)
  // --- Auth hardening (Section 8) ---
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens      RefreshToken[]
  alertSubscriptions AlertSubscription[]
  purchaseOrders     PurchaseOrder[] @relation("CreatedBy")
  approvedPOs        PurchaseOrder[] @relation("ApprovedBy")
  requestedPOs       PurchaseOrder[] @relation("RequestedBy")
  goodsReceipts      GoodsReceipt[]  @relation("GoodsReceiptReceivedBy")
  reversedReceipts   GoodsReceipt[]  @relation("GoodsReceiptReversedBy")
  qaActionedReceiptLines GoodsReceiptLine[] @relation("GoodsReceiptLineQaBy")
  shipments          Shipment[]
  events             EventLog[]
  acknowledgedAlerts Alert[]
  requestedTransfers StockTransfer[]
  startedCycleCounts CycleCount[] @relation("CycleCountStartedBy")
  postedCycleCounts  CycleCount[] @relation("CycleCountPostedBy")
  createdBoms        BillOfMaterials[]
  createdProductionOrders ProductionOrder[]
  createdInvoices    SupplierInvoice[] @relation("InvoiceCreatedBy")
  approvedInvoices   SupplierInvoice[] @relation("InvoiceApprovedBy")
  voidedInvoices     SupplierInvoice[] @relation("InvoiceVoidedBy")
  createdPayments    Payment[]         @relation("PaymentCreatedBy")
  voidedPayments     Payment[]         @relation("PaymentVoidedBy")
  createdCustomers   Customer[]        @relation("CustomerCreatedBy")
  createdSalesOrders SalesOrder[]      @relation("SalesOrderCreatedBy")
  createdFxRates     FxRate[]
}

enum Role {
  ADMIN
  PROCUREMENT
  WAREHOUSE
  FINANCE
  SALES
  PRODUCTION
  READ_ONLY
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ipAddress  String?

  @@index([userId])
  @@index([expiresAt])
}

enum ProductType {
  RAW
  COMPONENT
  FINISHED
  PACKAGING
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id                   String   @id @default(uuid())
  name                 String   @unique
  parentId             String?
  parent               Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children             Category[] @relation("CategoryParent")
  abcDefault           String?  // A | B | C
  defaultServiceLevel  Float?   // e.g. 0.95
  createdAt            DateTime @default(now())

  products Product[]
}

model Product {
  id             String   @id @default(uuid())
  sku            String   @unique
  name           String
  description    String?
  uom            String   @default("each") // each | box | case
  gtin           String?
  weightKg       Decimal? @db.Decimal(10, 3)
  hsCode         String?
  certifications Json?    // [{ id, type: "NIOSH" | "EN149" | "EN14683" | "CE", number, issuedAt, expiresAt, documentKey? }]
  externalIds    Json?    // { shopify?: { variantId, inventoryItemId, locationId } }
  abcClass       String?  // A | B | C
  xyzClass       String?  // X | Y | Z
  reorderPoint   Int      @default(10)
  reorderQty     Int      @default(50)
  costPrice      Decimal  @db.Decimal(12, 2) // last known cost, for reference only
  sellingPrice   Decimal  @db.Decimal(12, 2)
  type           ProductType @default(RAW)
  isManufactured Boolean  @default(false)
  standardLaborCost    Decimal @db.Decimal(12, 4) @default(0)
  standardOverheadCost Decimal @db.Decimal(12, 4) @default(0)
  isActive       Boolean  @default(true)
  version        Int      @default(0) // optimistic locking
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  supplierProducts   SupplierProduct[]
  stockLevels        StockLevel[]
  lots               Lot[]
  stockMovements     StockMovement[]
  costLayers         CostLayer[]
  cogsPostings       CogsPosting[]
  poLines            PurchaseOrderLine[]
  shipmentLines      ShipmentLine[]
  forecasts          Forecast[]
  reorderRecs        ReorderRecommendation[]
  binStockLevels      BinStockLevel[]
  stockTransferLines  StockTransferLine[]
  cycleCountLines     CycleCountLine[]
  bomsAsParent        BillOfMaterials[] @relation("BomParentProduct")
  bomLinesAsComponent BomLine[]         @relation("BomComponentProduct")
  productionOrders    ProductionOrder[]
  productionOrderLines ProductionOrderLine[]
  salesOrderLines     SalesOrderLine[]

  @@index([categoryId])
  @@index([isActive])
  @@index([type])
}

// ─── Locations ────────────────────────────────────────────────────────────────

model Warehouse {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  address         String?
  country         String?
  currency        String   @default("USD")
  taxJurisdiction String?
  isActive        Boolean  @default(true)
  lotPrefix       String?
  defaultReceivingBinId String?
  createdAt       DateTime @default(now())

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  costLayers     CostLayer[]
  forecasts      Forecast[]
  zones          WarehouseZone[]
  bins           BinLocation[] @relation("WarehouseBins")
  defaultReceivingBin BinLocation? @relation("WarehouseDefaultReceivingBin", fields: [defaultReceivingBinId], references: [id])
  binStockLevels BinStockLevel[]
  outgoingTransfers StockTransfer[] @relation("TransferSourceWarehouse")
  incomingTransfers StockTransfer[] @relation("TransferDestinationWarehouse")
  cycleCounts    CycleCount[]
  goodsReceipts  GoodsReceipt[]
  productionOrders ProductionOrder[]
  salesOrders    SalesOrder[]
  shipments      Shipment[]
}

model WarehouseZone {
  id          String   @id @default(uuid())
  warehouseId String
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  bins      BinLocation[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model BinLocation {
  id          String   @id @default(uuid())
  warehouseId String
  zoneId      String?
  code        String
  name        String?
  barcode     String?  @unique
  binType     String   @default("PICK") // PICK | BULK | RECEIVING | QA | DAMAGED | RETURNS
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  warehouse Warehouse      @relation("WarehouseBins", fields: [warehouseId], references: [id])
  zone      WarehouseZone? @relation(fields: [zoneId], references: [id])
  binStockLevels BinStockLevel[]
  stockMovements StockMovement[]
  lots      Lot[]
  cycleCountLines CycleCountLine[]
  defaultReceivingForWarehouses Warehouse[] @relation("WarehouseDefaultReceivingBin")

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([zoneId])
}

// Per-warehouse stock position. The single source of truth for "what we have where".
model StockLevel {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  onHand      Int      @default(0)
  reserved    Int      @default(0) // committed to open sales orders
  inTransit   Int      @default(0)
  quarantine  Int      @default(0) // pending QA
  damaged     Int      @default(0)
  version     Int      @default(0) // optimistic locking
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model BinStockLevel {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  binId       String
  onHand      Int      @default(0)
  reserved    Int      @default(0)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt

  product   Product     @relation(fields: [productId], references: [id])
  warehouse Warehouse   @relation(fields: [warehouseId], references: [id])
  bin       BinLocation @relation(fields: [binId], references: [id])

  @@unique([productId, binId])
  @@index([warehouseId, binId])
}

// ─── Suppliers ────────────────────────────────────────────────────────────────

model Supplier {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  legalName       String?
  taxId           String?
  taxRegistered   Boolean  @default(false)
  currency        String   @default("USD")
  paymentTerms    String   @default("NET30") // NET15 | NET30 | NET45 | NET60 | NET90 | COD | PREPAID
  incoterms       String?  // EXW | FOB | CIF | DAP | DDP ...
  leadTimeDays    Int      @default(7)

  // Primary contact (kept for back-compat; multi-contact via SupplierContact)
  primaryContact  String?
  email           String?
  phone           String?
  website         String?

  // Address
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?

  // Banking
  bankName            String?
  bankAccountNumber   String?
  iban                String?
  swift               String?

  riskRating       String?  // LOW | MEDIUM | HIGH
  approvalStatus   String   @default("DRAFT") // DRAFT | UNDER_REVIEW | APPROVED | PREFERRED | BLOCKED
  notes            String?

  // 3-way-match tolerances (null → use global default from AlertRule)
  qtyTolerancePct    Decimal? @db.Decimal(5, 2)
  priceTolerancePct  Decimal? @db.Decimal(5, 2)

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  supplierProducts SupplierProduct[]
  performance      SupplierPerformance[]
  purchaseOrders   PurchaseOrder[]
  invoices         SupplierInvoice[]
  apEntries        ApLedgerEntry[]
  payments         Payment[]
  lots             Lot[]
  contacts         SupplierContact[]
  documents        SupplierDocument[]
  categoryLinks    SupplierCategoryLink[]

  @@index([approvalStatus])
  @@index([country])
  @@index([riskRating])
}

// Multiple contacts per supplier (replaces the single primaryContact string)
model SupplierContact {
  id          String   @id @default(uuid())
  supplierId  String
  name        String
  role        String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, isPrimary])
}

// Document attachments (contracts, certs, insurance, ...)
model SupplierDocument {
  id            String    @id @default(uuid())
  supplierId    String
  category      String    // CONTRACT | NDA | ISO_CERT | INSURANCE | TAX_CERT | BANK_LETTER | OTHER
  title         String
  filename      String
  storagePath   String
  mimeType      String
  sizeBytes     Int
  expiresAt     DateTime?
  uploadedById  String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, category])
  @@index([expiresAt])
}

// Categories for grouping suppliers (RAW_MATERIALS, PACKAGING, ...)
model SupplierCategory {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  supplierLinks SupplierCategoryLink[]
}

model SupplierCategoryLink {
  supplierId String
  categoryId String
  createdAt  DateTime @default(now())

  supplier Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category SupplierCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([supplierId, categoryId])
  @@index([categoryId])
}

// Per-supplier per-SKU commercial terms (primary/secondary/backup sourcing)
model SupplierProduct {
  id             String  @id @default(uuid())
  supplierId     String
  productId      String
  supplierSku    String?
  agreedPrice    Decimal @db.Decimal(12, 2)
  moq            Int     @default(1)
  leadTimeDays   Int?
  priority       Int     @default(1) // 1 = primary, 2 = secondary, 3 = backup

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@index([productId, priority])
}

// Rolling supplier scorecards — recomputed daily
model SupplierPerformance {
  id            String   @id @default(uuid())
  supplierId    String
  periodStart   DateTime
  periodEnd     DateTime
  onTimeRate    Float?   // 0..1
  fillRate      Float?
  defectRate    Float?
  leadTimeMean  Float?
  leadTimeStd   Float?
  source        String   @default("MANUAL") // MANUAL | AUTO
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, periodStart])
}

// ─── Lots & Inventory Movements ───────────────────────────────────────────────

model Lot {
  id            String    @id @default(uuid())
  lotNumber     String    @unique
  productId     String
  supplierId    String?
  receivedDate  DateTime  @default(now())
  expiryDate    DateTime?
  qtyReceived   Int
  qtyRemaining  Int
  qaStatus      String    @default("RELEASED") // PENDING | RELEASED | REJECTED | QUARANTINED
  currentBinId  String?

  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  currentBin BinLocation? @relation(fields: [currentBinId], references: [id])

  costLayers     CostLayer[]
  movements      StockMovement[]
  stockTransferLines StockTransferLine[]
  cycleCountLines    CycleCountLine[]
  productionOutputs  ProductionOutput[]
  productionConsumptions ProductionConsumptionLot[]
  goodsReceiptLines  GoodsReceiptLine[] @relation("GoodsReceiptLineLot")

  @@index([productId, expiryDate])
  @@index([currentBinId])
}

// Append-only ledger of every stock change. Never updated, never deleted.
model StockMovement {
  id            String   @id @default(uuid())
  productId     String
  warehouseId   String
  binId         String?
  lotId         String?
  qty           Int      // signed: positive = in, negative = out
  direction     String   // IN | OUT | TRANSFER
  reasonCode    String   // RECEIPT | SHIPMENT | ADJUSTMENT | RETURN | TRANSFER | SCRAP | QA_HOLD | QA_RELEASE
  sourceDocType String?  // PO | SO | RMA | CYCLE_COUNT | MANUAL
  sourceDocId   String?
  operatorId    String?
  notes         String?
  createdAt     DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  bin       BinLocation? @relation(fields: [binId], references: [id])
  lot       Lot?      @relation(fields: [lotId], references: [id])

  @@index([productId, warehouseId, createdAt])
  @@index([binId, createdAt])
  @@index([sourceDocType, sourceDocId])
}

model StockTransfer {
  id                     String   @id @default(uuid())
  transferNumber         String   @unique
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 String   @default("DRAFT") // DRAFT | IN_TRANSIT | RECEIVED | CANCELLED
  requestedById          String?
  shippedAt              DateTime?
  receivedAt             DateTime?
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  sourceWarehouse      Warehouse @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse Warehouse @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  requestedBy          User?     @relation(fields: [requestedById], references: [id])
  lines                StockTransferLine[]

  @@index([sourceWarehouseId, status])
  @@index([destinationWarehouseId, status])
}

model StockTransferLine {
  id              String @id @default(uuid())
  transferId      String
  productId       String
  lotId           String?
  sourceBinId     String?
  destinationBinId String?
  qtyRequested    Int
  qtyShipped      Int    @default(0)
  qtyReceived     Int    @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])
  lot      Lot?          @relation(fields: [lotId], references: [id])

  @@index([transferId])
  @@index([productId])
}

model CycleCount {
  id          String   @id @default(uuid())
  countNumber String   @unique
  warehouseId String
  status      String   @default("OPEN") // OPEN | POSTED | CANCELLED
  startedById String?
  postedById  String?
  startedAt   DateTime @default(now())
  postedAt    DateTime?
  notes       String?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  startedBy User?     @relation("CycleCountStartedBy", fields: [startedById], references: [id])
  postedBy  User?     @relation("CycleCountPostedBy", fields: [postedById], references: [id])
  lines     CycleCountLine[]

  @@index([warehouseId, status])
}

model CycleCountLine {
  id          String   @id @default(uuid())
  cycleCountId String
  productId   String
  binId       String?
  lotId       String?
  expectedQty Int
  countedQty  Int?
  varianceQty Int?
  notes       String?
  countedAt   DateTime?

  cycleCount CycleCount @relation(fields: [cycleCountId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  bin        BinLocation? @relation(fields: [binId], references: [id])
  lot        Lot?       @relation(fields: [lotId], references: [id])

  @@index([cycleCountId])
  @@index([productId])
}

// ─── FIFO Cost Engine ─────────────────────────────────────────────────────────
// Append-only. The financial backbone described in Section 04 of the master plan.

model CostLayer {
  id                  String   @id @default(uuid())
  productId           String
  warehouseId         String
  lotId               String?
  qtyReceived         Int
  qtyRemaining        Int      // depletes as units ship; never goes negative
  unitCost            Decimal  @db.Decimal(14, 4) // original-currency unit cost
  landedCostPerUnit   Decimal  @default(0) @db.Decimal(14, 4)
  currency            String   @default("USD")
  fxRate              Decimal  @default(1) @db.Decimal(14, 6)
  functionalUnitCost  Decimal  @db.Decimal(14, 4) // (unitCost + landedCostPerUnit) * fxRate
  receivedDate        DateTime
  poLineId            String?
  status              String   @default("ACTIVE") // ACTIVE | DEPLETED | LOCKED
  version             Int      @default(0)
  createdAt           DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lot       Lot?      @relation(fields: [lotId], references: [id])

  cogsPostings        CogsPosting[]
  landedCostAllocations LandedCostAllocation[]

  @@index([productId, warehouseId, receivedDate, status])
}

// Append-only log of every COGS posting created by FIFO depletion.
model CogsPosting {
  id                    String   @id @default(uuid())
  layerId               String
  productId             String
  qtyConsumed           Int
  unitCostAtConsumption Decimal  @db.Decimal(14, 4)
  cogsAmount            Decimal  @db.Decimal(14, 4)
  salesOrderId          String?
  shipmentId            String?
  postedAt              DateTime @default(now())

  layer   CostLayer @relation(fields: [layerId], references: [id])
  product Product   @relation(fields: [productId], references: [id])

  @@index([productId, postedAt])
  @@index([shipmentId])
}

model LandedCostAllocation {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  costType         String  // FREIGHT | DUTY | INSURANCE | BROKERAGE | OTHER
  totalAmount      Decimal @db.Decimal(14, 4)
  allocationMethod String  // VALUE | WEIGHT | VOLUME
  layerId          String
  allocatedAmount  Decimal @db.Decimal(14, 4)
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  layer         CostLayer     @relation(fields: [layerId], references: [id])
}

// ─── Procurement ──────────────────────────────────────────────────────────────

model PurchaseOrder {
  id              String    @id @default(uuid())
  poNumber        String    @unique
  supplierId      String
  status          POStatus  @default(DRAFT)
  totalAmount     Decimal   @default(0) @db.Decimal(14, 2)
  currency        String    @default("USD")
  fxRate          Decimal?  @db.Decimal(14, 6)
  expectedDate    DateTime?
  notes           String?
  requestedById   String?
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  submittedAt     DateTime?
  sentAt          DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  supplier    Supplier @relation(fields: [supplierId], references: [id])
  createdBy   User     @relation("CreatedBy", fields: [createdById], references: [id])
  approvedBy  User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  requestedBy User?    @relation("RequestedBy", fields: [requestedById], references: [id])

  lines               PurchaseOrderLine[]
  goodsReceipts       GoodsReceipt[]
  invoices            SupplierInvoice[]
  landedCostAllocations LandedCostAllocation[]

  @@index([supplierId, status])
  @@index([status, expectedDate])
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

model PurchaseOrderLine {
  id              String   @id @default(uuid())
  purchaseOrderId String
  productId       String
  qtyOrdered      Int
  qtyReceived     Int      @default(0)
  unitPrice       Decimal  @db.Decimal(14, 4)
  expectedDate    DateTime?
  notes           String?
  status          String   @default("OPEN") // OPEN | PARTIAL | COMPLETED | CANCELLED

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  receiptLines GoodsReceiptLine[]
  invoiceLines SupplierInvoiceLine[]

  @@index([purchaseOrderId, status])
}

model GoodsReceipt {
  id               String   @id @default(uuid())
  receiptNumber    String   @unique
  purchaseOrderId  String
  warehouseId      String
  receivedAt       DateTime @default(now())
  receivedById     String
  status           String   @default("RECEIVED") // RECEIVED | QA_HOLD | COMPLETED | REVERSED
  fxRateAtReceipt  Decimal? @db.Decimal(14, 6)
  notes            String?
  reversedAt       DateTime?
  reversedById     String?
  reverseReason    String?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  receivedBy    User          @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  reversedBy    User?         @relation("GoodsReceiptReversedBy", fields: [reversedById], references: [id])

  lines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([warehouseId, receivedAt])
}

model GoodsReceiptLine {
  id              String   @id @default(uuid())
  receiptId       String
  poLineId        String
  qtyReceived     Int
  lotId           String?
  qaStatus        String   @default("RELEASED") // PENDING | RELEASED | REJECTED
  qaActionedById  String?
  qaActionedAt    DateTime?
  qaNotes         String?

  receipt       GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLine        PurchaseOrderLine @relation(fields: [poLineId], references: [id])
  lot           Lot?              @relation("GoodsReceiptLineLot", fields: [lotId], references: [id])
  qaActionedBy  User?             @relation("GoodsReceiptLineQaBy", fields: [qaActionedById], references: [id])
  invoiceLines  SupplierInvoiceLine[]

  @@index([receiptId])
  @@index([poLineId])
}

// ─── Accounts Payable ─────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  RECEIVED
  MATCHED
  EXCEPTION
  APPROVED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  CHECK
  CARD
  OTHER
}

enum PaymentStatus {
  POSTED
  VOIDED
}

model SupplierInvoice {
  id                  String        @id @default(uuid())
  supplierId          String
  purchaseOrderId     String?
  invoiceNumber       String
  invoiceType         String        @default("STANDARD") // STANDARD | CREDIT_NOTE | DEBIT_NOTE
  invoiceDate         DateTime
  dueDate             DateTime
  subtotal            Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal       @default(0) @db.Decimal(14, 2)
  amount              Decimal       @db.Decimal(14, 2) // subtotal + taxAmount
  matchedAmount       Decimal       @default(0) @db.Decimal(14, 2)
  varianceAmount      Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount          Decimal       @default(0) @db.Decimal(14, 2)
  currency            String        @default("USD")
  fxRate              Decimal?      @db.Decimal(14, 6)
  status              InvoiceStatus @default(DRAFT)
  holdReason          String?
  notes               String?
  attachmentUrl       String?
  creditedInvoiceId   String?
  createdById         String?
  approvedById        String?
  voidedById          String?
  voidReason          String?
  receivedAt          DateTime?
  matchedAt           DateTime?
  approvedAt          DateTime?
  paidAt              DateTime?
  voidedAt            DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  supplier            Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder       PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  creditedInvoice     SupplierInvoice?      @relation("CreditNoteLink", fields: [creditedInvoiceId], references: [id])
  creditNotes         SupplierInvoice[]     @relation("CreditNoteLink")
  createdBy           User?                 @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  approvedBy          User?                 @relation("InvoiceApprovedBy", fields: [approvedById], references: [id])
  voidedBy            User?                 @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  lines               SupplierInvoiceLine[]
  apEntries           ApLedgerEntry[]
  paymentApplications PaymentApplication[]

  @@unique([supplierId, invoiceNumber])
  @@index([dueDate, status])
  @@index([supplierId, status])
  @@index([invoiceDate])
}

model SupplierInvoiceLine {
  id            String  @id @default(uuid())
  invoiceId     String
  poLineId      String?
  grnLineId     String?
  description   String
  quantity      Decimal @db.Decimal(14, 4)
  unitPrice     Decimal @db.Decimal(14, 4)
  lineTotal     Decimal @db.Decimal(14, 2)
  matchStatus   String  @default("PENDING") // PENDING | MATCHED | QTY_VARIANCE | PRICE_VARIANCE | NO_RECEIPT | NO_PO
  qtyVariance   Decimal? @db.Decimal(14, 4)
  priceVariance Decimal? @db.Decimal(14, 4)
  createdAt     DateTime @default(now())

  invoice SupplierInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  poLine  PurchaseOrderLine? @relation(fields: [poLineId], references: [id])
  grnLine GoodsReceiptLine?  @relation(fields: [grnLineId], references: [id])

  @@index([invoiceId])
  @@index([poLineId])
  @@index([grnLineId])
}

// Append-only AP ledger — every invoice and every payment is a line.
model ApLedgerEntry {
  id           String   @id @default(uuid())
  supplierId   String
  invoiceId    String?
  paymentId    String?
  entryType    String   @default("INVOICE_POSTED") // INVOICE_POSTED | PAYMENT_APPLIED | CREDIT_NOTE | INVOICE_VOIDED | PAYMENT_VOIDED
  amount       Decimal  @db.Decimal(14, 2) // positive = liability, negative = payment
  balance      Decimal  @db.Decimal(14, 2) // running balance snapshot (advisory)
  dueDate      DateTime?
  agingBucket  String?  // advisory snapshot — authoritative aging is computed on read
  description  String?
  createdAt    DateTime @default(now())

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  invoice  SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  payment  Payment?         @relation(fields: [paymentId], references: [id])

  @@index([supplierId, createdAt])
}

model Payment {
  id            String        @id @default(uuid())
  supplierId    String
  amount        Decimal       @db.Decimal(14, 2)
  currency      String        @default("USD")
  fxRate        Decimal?      @db.Decimal(14, 6)
  paymentDate   DateTime      @default(now())
  method        PaymentMethod
  status        PaymentStatus @default(POSTED)
  reference     String?
  notes         String?
  createdById   String?
  voidedById    String?
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier     Supplier              @relation(fields: [supplierId], references: [id])
  createdBy    User?                 @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  voidedBy     User?                 @relation("PaymentVoidedBy", fields: [voidedById], references: [id])
  applications PaymentApplication[]
  apEntries    ApLedgerEntry[]

  @@index([supplierId, paymentDate])
  @@index([status])
}

model PaymentApplication {
  id            String   @id @default(uuid())
  paymentId     String
  invoiceId     String
  amountApplied Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  payment Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// ─── Sales & Fulfillment ──────────────────────────────────────────────────────

enum PaymentTerms {
  NET_15
  NET_30
  NET_60
  NET_90
  COD
  PREPAID
}

model Customer {
  id              String        @id @default(uuid())
  code            String        @unique
  name            String
  email           String?
  phone           String?
  billingAddress  String?
  shippingAddress String?
  taxId           String?
  currency        String        @default("USD")
  paymentTerms    PaymentTerms  @default(NET_30)
  creditLimit     Decimal?      @db.Decimal(14, 2)
  notes           String?
  isActive        Boolean       @default(true)
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  createdBy   User?              @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  contacts    CustomerContact[]
  salesOrders SalesOrder[]

  @@index([isActive])
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  name       String
  email      String?
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model SalesOrder {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  source        String      @default("MANUAL") // SHOPIFY | MANUAL | B2B
  externalId    String?     // Shopify order ID
  customerId    String?
  customerName  String
  customerEmail String?
  warehouseId   String?
  status        SOStatus    @default(RECEIVED)
  totalAmount   Decimal     @default(0) @db.Decimal(14, 2)
  currency      String      @default("USD")
  notes         String?
  createdById   String?
  confirmedAt   DateTime?
  allocatedAt   DateTime?
  pickedAt      DateTime?
  packedAt      DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  orderedAt     DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customer  Customer?  @relation(fields: [customerId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  createdBy User?      @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  lines     SalesOrderLine[]
  shipments Shipment[]

  @@index([source, externalId])
  @@index([status])
  @@index([customerId])
}

enum SOStatus {
  RECEIVED
  CONFIRMED
  ALLOCATED
  PICKED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model SalesOrderLine {
  id           String   @id @default(uuid())
  salesOrderId String
  productId    String
  qty          Int
  qtyAllocated Int      @default(0)
  qtyPicked    Int      @default(0)
  qtyShipped   Int      @default(0)
  unitPrice    Decimal  @db.Decimal(14, 4)
  status       String   @default("OPEN")
  notes        String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@index([productId])
}

model Shipment {
  id               String         @id @default(uuid())
  shipmentNumber   String         @unique
  salesOrderId     String?
  warehouseId      String?
  carrier          String?        // BOSTA | DHL | ARAMEX | OTHER
  carrierRef       String?
  trackingNumber   String?
  status           ShipmentStatus @default(PENDING)
  dispatchedAt     DateTime?
  estimatedArrival DateTime?
  deliveredAt      DateTime?
  voidedAt         DateTime?
  voidReason       String?
  notes            String?
  labelKey         String?        // Storage key for the carrier label PDF (Bosta etc.)
  lastTrackingEventId String?     // Last carrier-provided event id, for idempotent webhook updates
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])
  warehouse  Warehouse?  @relation(fields: [warehouseId], references: [id])
  createdBy  User        @relation(fields: [createdById], references: [id])

  lines          ShipmentLine[]
  trackingEvents TrackingEvent[]

  @@index([salesOrderId])
  @@index([status])
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  VOIDED
}

model ShipmentLine {
  id                String   @id @default(uuid())
  shipmentId        String
  productId         String
  salesOrderLineId  String?
  qty               Int
  unitPrice         Decimal? @db.Decimal(14, 2)
  unitCost          Decimal? @db.Decimal(14, 4)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([shipmentId])
  @@index([productId])
}

model TrackingEvent {
  id         String   @id @default(uuid())
  shipmentId String
  eventType  String   // PICKUP | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | EXCEPTION
  occurredAt DateTime
  location   String?
  rawPayload Json?
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

// ─── Intelligence Layer ───────────────────────────────────────────────────────

model Forecast {
  id                  String   @id @default(uuid())
  productId           String
  warehouseId         String?
  periodStart         DateTime
  horizonDays         Int
  predictedQty        Int
  confidenceLow       Int?
  confidenceHigh      Int?
  modelUsed           String   // PROPHET | EXP_SMOOTH | MOVING_AVG | SEED
  mape                Float?   // accuracy of previous forecast
  createdAt           DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId, periodStart])
  @@index([productId, periodStart])
}

model ReorderRecommendation {
  id              String   @id @default(uuid())
  productId       String
  suggestedQty    Int
  targetSupplierId String?
  urgency         String   // LOW | MEDIUM | HIGH | CRITICAL
  reasoning       Json     // explanation payload: stock, velocity, lead time, projected stockout
  status          String   @default("PENDING") // PENDING | DRAFTED_PO | DISMISSED
  createdAt       DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, status])
}

model Alert {
  id                String   @id @default(uuid())
  type              String   // STOCKOUT_RISK | REORDER | DEMAND_ANOMALY | SUPPLIER_PERF | LEAD_TIME | PAYMENT_DUE | OVERDUE | SHIPMENT_DELAY | MARGIN | EXPIRY | DEAD_STOCK | BOM_SHORTAGE | CREDIT_LIMIT
  severity          String   // LOW | MEDIUM | HIGH | CRITICAL
  productId         String?
  supplierId        String?
  entityType        String?  // optional: cross-module link (Customer | Shipment | SupplierInvoice | etc.)
  entityId          String?
  payload           Json     // structured data underlying the alert
  reasoning         String   // human-readable explanation
  audienceRoles     String[] @default([]) // [] = visible to all authenticated users; non-empty = restricted
  status            String   @default("OPEN") // OPEN | ACKNOWLEDGED | SNOOZED | RESOLVED
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  snoozedUntil      DateTime?
  resolvedAt        DateTime?
  sourceEventId     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  acknowledgedBy User? @relation(fields: [acknowledgedById], references: [id])

  @@index([status, severity, createdAt])
  @@index([status, type])
  @@index([type, entityType, entityId])
}

// Persisted thresholds for alert generators. Allows admins to tune triggers without code changes.
model AlertRule {
  id        String   @id @default(uuid())
  type      String   @unique // matches Alert.type
  enabled   Boolean  @default(true)
  params    Json     // e.g. { threshold: 0.85, days: 7 }
  updatedAt DateTime @updatedAt
}

// FX rate registry — append-only. Most-recent row per (base,quote) ≤ effectiveAt wins.
model FxRate {
  id             String   @id @default(uuid())
  baseCurrency   String   // e.g. 'USD'
  quoteCurrency  String   // e.g. 'EGP'
  rate           Decimal  @db.Decimal(18, 8)
  effectiveAt    DateTime
  source         String   @default("manual") // manual | ecb | openexchangerates
  createdAt      DateTime @default(now())
  createdById    String?

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([baseCurrency, quoteCurrency, effectiveAt])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

// Append-only event log. Every state-changing action lands here.
model EventLog {
  id         String   @id @default(uuid())
  eventType  String   // PO_CREATED | PO_APPROVED | GOODS_RECEIVED | SHIPMENT_DISPATCHED | COGS_POSTED | etc.
  entityType String
  entityId   String
  actorId    String?
  payload    Json?
  sourceIp   String?
  occurredAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([occurredAt])
}

// ─── Manufacturing / BOM / Production ─────────────────────────────────────────

// One Bill of Materials version for a finished/sub-assembly product.
// Versioned: many drafts/archived per product, exactly one active enforced in app.
model BillOfMaterials {
  id           String    @id @default(uuid())
  productId    String
  version      Int
  isActive     Boolean   @default(false)
  notes        String?
  createdById  String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product   Product @relation("BomParentProduct", fields: [productId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])
  lines     BomLine[]
  productionOrders ProductionOrder[]

  @@unique([productId, version])
  @@index([productId, isActive])
}

model BomLine {
  id                 String   @id @default(uuid())
  bomId              String
  componentProductId String
  qtyPer             Decimal  @db.Decimal(12, 4)
  uom                String   @default("each")
  scrapFactorPct     Decimal  @db.Decimal(5, 2) @default(0)
  position           Int      @default(0)
  notes              String?

  bom              BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentProduct Product         @relation("BomComponentProduct", fields: [componentProductId], references: [id])

  @@index([bomId])
  @@index([componentProductId])
}

model ProductionOrder {
  id            String    @id @default(uuid())
  orderNumber   String    @unique
  productId     String    // finished good
  bomId         String
  warehouseId   String
  plannedQty    Int
  producedQty   Int       @default(0)
  scrapQty      Int       @default(0)
  status        String    @default("DRAFT") // DRAFT | RELEASED | IN_PROGRESS | COMPLETED | CANCELLED
  plannedAt     DateTime  @default(now())
  releasedAt    DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdById   String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product   Product         @relation(fields: [productId], references: [id])
  bom       BillOfMaterials @relation(fields: [bomId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy User?           @relation(fields: [createdById], references: [id])
  lines     ProductionOrderLine[]
  outputs   ProductionOutput[]
  consumptions ProductionConsumptionLot[]

  @@index([status, plannedAt])
  @@index([productId])
  @@index([warehouseId])
}

model ProductionOrderLine {
  id                 String   @id @default(uuid())
  productionOrderId  String
  componentProductId String
  plannedQty         Decimal  @db.Decimal(12, 4)
  consumedQty        Decimal  @db.Decimal(12, 4) @default(0)
  unitCostSnapshot   Decimal? @db.Decimal(12, 4) // FIFO weighted-avg captured at release
  uom                String   @default("each")

  productionOrder  ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  componentProduct Product         @relation(fields: [componentProductId], references: [id])

  @@index([productionOrderId])
}

// One row per finished-good output event on a production order.
model ProductionOutput {
  id                  String   @id @default(uuid())
  productionOrderId   String
  lotId               String
  qty                 Int
  totalComponentCost  Decimal  @db.Decimal(12, 2)
  laborCost           Decimal  @db.Decimal(12, 2)
  overheadCost        Decimal  @db.Decimal(12, 2)
  unitCost            Decimal  @db.Decimal(12, 4)
  createdAt           DateTime @default(now())

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lot             Lot             @relation(fields: [lotId], references: [id])

  @@index([productionOrderId])
}

// Genealogy: which component lots were consumed by which production order.
model ProductionConsumptionLot {
  id                String   @id @default(uuid())
  productionOrderId String
  lotId             String
  qtyConsumed       Int
  unitCost          Decimal  @db.Decimal(12, 4)
  createdAt         DateTime @default(now())

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  lot             Lot             @relation(fields: [lotId], references: [id])

  @@index([productionOrderId])
  @@index([lotId])
}

// ─── Section 9 — Integrations & Notifications ────────────────────────────────

// At-least-once outbound delivery queue (Shopify, Bosta, email).
model IntegrationOutbox {
  id              String   @id @default(uuid())
  target          String   // "shopify" | "bosta" | "email"
  action          String   // e.g. "fulfillments.create", "inventory_levels.set", "single-alert"
  payload         Json
  status          String   @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts        Int      @default(0)
  nextAttemptAt   DateTime @default(now())
  lastError       String?
  sentAt          DateTime?
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([target, status])
}

// Per-user subscription filter for outbound notifications.
model AlertSubscription {
  id        String   @id @default(uuid())
  userId    String
  alertType String?  // null = all types
  severity  String?  // null = all severities (LOW|MEDIUM|HIGH|CRITICAL)
  channel   String   @default("EMAIL") // EMAIL | SMS | SLACK (only EMAIL for v1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([alertType, severity, isActive])
}
