// RPE Chain — Supply OS
// Data model derived from Master Plan v1.0 (May 2026)
// Design principles: append-only ledgers, soft deletes, multi-tenant ready,
// UTC timestamps, optimistic locking on hot rows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & Access ────────────────────────────────────────────────────────

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(READ_ONLY)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  purchaseOrders     PurchaseOrder[] @relation("CreatedBy")
  approvedPOs        PurchaseOrder[] @relation("ApprovedBy")
  goodsReceipts      GoodsReceipt[]
  shipments          Shipment[]
  events             EventLog[]
  acknowledgedAlerts Alert[]
}

enum Role {
  ADMIN
  PROCUREMENT
  WAREHOUSE
  FINANCE
  SALES
  READ_ONLY
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id                   String   @id @default(uuid())
  name                 String   @unique
  parentId             String?
  parent               Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children             Category[] @relation("CategoryParent")
  abcDefault           String?  // A | B | C
  defaultServiceLevel  Float?   // e.g. 0.95
  createdAt            DateTime @default(now())

  products Product[]
}

model Product {
  id             String   @id @default(uuid())
  sku            String   @unique
  name           String
  description    String?
  uom            String   @default("each") // each | box | case
  gtin           String?
  weightKg       Decimal? @db.Decimal(10, 3)
  hsCode         String?
  certifications Json?    // [{ type: "NIOSH" | "EN149" | "CE", number, issuedAt, expiresAt }]
  abcClass       String?  // A | B | C
  xyzClass       String?  // X | Y | Z
  reorderPoint   Int      @default(10)
  reorderQty     Int      @default(50)
  costPrice      Decimal  @db.Decimal(12, 2) // last known cost, for reference only
  sellingPrice   Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  version        Int      @default(0) // optimistic locking
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  supplierProducts   SupplierProduct[]
  stockLevels        StockLevel[]
  lots               Lot[]
  stockMovements     StockMovement[]
  costLayers         CostLayer[]
  cogsPostings       CogsPosting[]
  poLines            PurchaseOrderLine[]
  shipmentLines      ShipmentLine[]
  forecasts          Forecast[]
  reorderRecs        ReorderRecommendation[]

  @@index([categoryId])
  @@index([isActive])
}

// ─── Locations ────────────────────────────────────────────────────────────────

model Warehouse {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  address         String?
  taxJurisdiction String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  costLayers     CostLayer[]
  forecasts      Forecast[]
}

// Per-warehouse stock position. The single source of truth for "what we have where".
model StockLevel {
  id          String   @id @default(uuid())
  productId   String
  warehouseId String
  onHand      Int      @default(0)
  reserved    Int      @default(0) // committed to open sales orders
  inTransit   Int      @default(0)
  quarantine  Int      @default(0) // pending QA
  damaged     Int      @default(0)
  version     Int      @default(0) // optimistic locking
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

// ─── Suppliers ────────────────────────────────────────────────────────────────

model Supplier {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  legalName       String?
  taxId           String?
  currency        String   @default("USD")
  paymentTerms    String   @default("NET30") // NET15 | NET30 | NET45 | NET60 | NET90 | COD | PREPAID
  leadTimeDays    Int      @default(7)
  primaryContact  String?
  email           String?
  phone           String?
  country         String?
  riskRating      String?  // LOW | MEDIUM | HIGH
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  supplierProducts SupplierProduct[]
  performance      SupplierPerformance[]
  purchaseOrders   PurchaseOrder[]
  invoices         SupplierInvoice[]
  apEntries        ApLedgerEntry[]
  payments         Payment[]
  lots             Lot[]
}

// Per-supplier per-SKU commercial terms (primary/secondary/backup sourcing)
model SupplierProduct {
  id             String  @id @default(uuid())
  supplierId     String
  productId      String
  supplierSku    String?
  agreedPrice    Decimal @db.Decimal(12, 2)
  moq            Int     @default(1)
  leadTimeDays   Int?
  priority       Int     @default(1) // 1 = primary, 2 = secondary, 3 = backup

  supplier Supplier @relation(fields: [supplierId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@index([productId, priority])
}

// Rolling supplier scorecards — recomputed daily
model SupplierPerformance {
  id            String   @id @default(uuid())
  supplierId    String
  periodStart   DateTime
  periodEnd     DateTime
  onTimeRate    Float?   // 0..1
  fillRate      Float?
  defectRate    Float?
  leadTimeMean  Float?
  leadTimeStd   Float?
  createdAt     DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, periodStart])
}

// ─── Lots & Inventory Movements ───────────────────────────────────────────────

model Lot {
  id            String    @id @default(uuid())
  lotNumber     String    @unique
  productId     String
  supplierId    String?
  receivedDate  DateTime  @default(now())
  expiryDate    DateTime?
  qtyReceived   Int
  qtyRemaining  Int
  qaStatus      String    @default("RELEASED") // PENDING | RELEASED | REJECTED | QUARANTINED

  product  Product   @relation(fields: [productId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  costLayers     CostLayer[]
  movements      StockMovement[]

  @@index([productId, expiryDate])
}

// Append-only ledger of every stock change. Never updated, never deleted.
model StockMovement {
  id            String   @id @default(uuid())
  productId     String
  warehouseId   String
  lotId         String?
  qty           Int      // signed: positive = in, negative = out
  direction     String   // IN | OUT | TRANSFER
  reasonCode    String   // RECEIPT | SHIPMENT | ADJUSTMENT | RETURN | TRANSFER | SCRAP | QA_HOLD | QA_RELEASE
  sourceDocType String?  // PO | SO | RMA | CYCLE_COUNT | MANUAL
  sourceDocId   String?
  operatorId    String?
  notes         String?
  createdAt     DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lot       Lot?      @relation(fields: [lotId], references: [id])

  @@index([productId, warehouseId, createdAt])
  @@index([sourceDocType, sourceDocId])
}

// ─── FIFO Cost Engine ─────────────────────────────────────────────────────────
// Append-only. The financial backbone described in Section 04 of the master plan.

model CostLayer {
  id                  String   @id @default(uuid())
  productId           String
  warehouseId         String
  lotId               String?
  qtyReceived         Int
  qtyRemaining        Int      // depletes as units ship; never goes negative
  unitCost            Decimal  @db.Decimal(14, 4) // original-currency unit cost
  landedCostPerUnit   Decimal  @default(0) @db.Decimal(14, 4)
  currency            String   @default("USD")
  fxRate              Decimal  @default(1) @db.Decimal(14, 6)
  functionalUnitCost  Decimal  @db.Decimal(14, 4) // (unitCost + landedCostPerUnit) * fxRate
  receivedDate        DateTime
  poLineId            String?
  status              String   @default("ACTIVE") // ACTIVE | DEPLETED | LOCKED
  version             Int      @default(0)
  createdAt           DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  lot       Lot?      @relation(fields: [lotId], references: [id])

  cogsPostings        CogsPosting[]
  landedCostAllocations LandedCostAllocation[]

  @@index([productId, warehouseId, receivedDate, status])
}

// Append-only log of every COGS posting created by FIFO depletion.
model CogsPosting {
  id                    String   @id @default(uuid())
  layerId               String
  productId             String
  qtyConsumed           Int
  unitCostAtConsumption Decimal  @db.Decimal(14, 4)
  cogsAmount            Decimal  @db.Decimal(14, 4)
  salesOrderId          String?
  shipmentId            String?
  postedAt              DateTime @default(now())

  layer   CostLayer @relation(fields: [layerId], references: [id])
  product Product   @relation(fields: [productId], references: [id])

  @@index([productId, postedAt])
  @@index([shipmentId])
}

model LandedCostAllocation {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  costType         String  // FREIGHT | DUTY | INSURANCE | BROKERAGE | OTHER
  totalAmount      Decimal @db.Decimal(14, 4)
  allocationMethod String  // VALUE | WEIGHT | VOLUME
  layerId          String
  allocatedAmount  Decimal @db.Decimal(14, 4)
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  layer         CostLayer     @relation(fields: [layerId], references: [id])
}

// ─── Procurement ──────────────────────────────────────────────────────────────

model PurchaseOrder {
  id            String    @id @default(uuid())
  poNumber      String    @unique
  supplierId    String
  status        POStatus  @default(DRAFT)
  totalAmount   Decimal   @default(0) @db.Decimal(14, 2)
  currency      String    @default("USD")
  expectedDate  DateTime?
  notes         String?
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  createdBy  User     @relation("CreatedBy", fields: [createdById], references: [id])
  approvedBy User?    @relation("ApprovedBy", fields: [approvedById], references: [id])

  lines               PurchaseOrderLine[]
  goodsReceipts       GoodsReceipt[]
  invoices            SupplierInvoice[]
  landedCostAllocations LandedCostAllocation[]

  @@index([supplierId, status])
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderLine {
  id              String   @id @default(uuid())
  purchaseOrderId String
  productId       String
  qtyOrdered      Int
  qtyReceived     Int      @default(0)
  unitPrice       Decimal  @db.Decimal(14, 4)
  expectedDate    DateTime?
  status          String   @default("OPEN") // OPEN | PARTIAL | COMPLETED | CANCELLED

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  receiptLines GoodsReceiptLine[]
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  receiptNumber   String   @unique
  purchaseOrderId String
  warehouseId     String
  receivedAt      DateTime @default(now())
  receivedById    String
  status          String   @default("RECEIVED") // RECEIVED | QA_HOLD | COMPLETED

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User          @relation(fields: [receivedById], references: [id])

  lines GoodsReceiptLine[]
}

model GoodsReceiptLine {
  id           String  @id @default(uuid())
  receiptId    String
  poLineId     String
  qtyReceived  Int
  lotId        String?
  qaStatus     String  @default("RELEASED") // PENDING | RELEASED | REJECTED

  receipt GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLine  PurchaseOrderLine @relation(fields: [poLineId], references: [id])
}

// ─── Accounts Payable ─────────────────────────────────────────────────────────

model SupplierInvoice {
  id              String   @id @default(uuid())
  supplierId      String
  purchaseOrderId String?
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime
  amount          Decimal  @db.Decimal(14, 2)
  currency        String   @default("USD")
  status          String   @default("OPEN") // OPEN | MATCHED | DISPUTED | PAID | CANCELLED
  createdAt       DateTime @default(now())

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  apEntries     ApLedgerEntry[]

  @@unique([supplierId, invoiceNumber])
  @@index([dueDate, status])
}

// Append-only AP ledger — every invoice and every payment is a line.
model ApLedgerEntry {
  id           String   @id @default(uuid())
  supplierId   String
  invoiceId    String?
  paymentId    String?
  amount       Decimal  @db.Decimal(14, 2) // positive = liability, negative = payment
  balance      Decimal  @db.Decimal(14, 2) // running balance for the supplier after this entry
  dueDate      DateTime?
  agingBucket  String?  // CURRENT | 1_30 | 31_60 | 61_90 | OVER_90
  description  String?
  createdAt    DateTime @default(now())

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  invoice  SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  payment  Payment?         @relation(fields: [paymentId], references: [id])

  @@index([supplierId, createdAt])
}

model Payment {
  id            String   @id @default(uuid())
  supplierId    String
  amount        Decimal  @db.Decimal(14, 2)
  currency      String   @default("USD")
  paymentDate   DateTime @default(now())
  method        String   // BANK_TRANSFER | CHECK | CARD | OTHER
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())

  supplier  Supplier        @relation(fields: [supplierId], references: [id])
  apEntries ApLedgerEntry[]
}

// ─── Sales & Fulfillment ──────────────────────────────────────────────────────

model SalesOrder {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  source        String      @default("MANUAL") // SHOPIFY | MANUAL | B2B
  externalId    String?     // Shopify order ID
  customerName  String
  customerEmail String?
  status        SOStatus    @default(RECEIVED)
  totalAmount   Decimal     @default(0) @db.Decimal(14, 2)
  currency      String      @default("USD")
  orderedAt     DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lines     SalesOrderLine[]
  shipments Shipment[]

  @@index([source, externalId])
  @@index([status])
}

enum SOStatus {
  RECEIVED
  CONFIRMED
  ALLOCATED
  PICKED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model SalesOrderLine {
  id           String   @id @default(uuid())
  salesOrderId String
  productId    String
  qty          Int
  qtyShipped   Int      @default(0)
  unitPrice    Decimal  @db.Decimal(14, 4)
  status       String   @default("OPEN")

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model Shipment {
  id               String         @id @default(uuid())
  shipmentNumber   String         @unique
  salesOrderId     String?
  carrier          String?        // BOSTA | DHL | ARAMEX | OTHER
  carrierRef       String?
  trackingNumber   String?
  status           ShipmentStatus @default(PENDING)
  dispatchedAt     DateTime?
  estimatedArrival DateTime?
  deliveredAt      DateTime?
  notes            String?
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])
  createdBy  User        @relation(fields: [createdById], references: [id])

  lines          ShipmentLine[]
  trackingEvents TrackingEvent[]
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model ShipmentLine {
  id         String @id @default(uuid())
  shipmentId String
  productId  String
  qty        Int

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model TrackingEvent {
  id         String   @id @default(uuid())
  shipmentId String
  eventType  String   // PICKUP | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | EXCEPTION
  occurredAt DateTime
  location   String?
  rawPayload Json?
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

// ─── Intelligence Layer ───────────────────────────────────────────────────────

model Forecast {
  id                  String   @id @default(uuid())
  productId           String
  warehouseId         String?
  periodStart         DateTime
  horizonDays         Int
  predictedQty        Int
  confidenceLow       Int?
  confidenceHigh      Int?
  modelUsed           String   // PROPHET | EXP_SMOOTH | MOVING_AVG | SEED
  mape                Float?   // accuracy of previous forecast
  createdAt           DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId, periodStart])
}

model ReorderRecommendation {
  id              String   @id @default(uuid())
  productId       String
  suggestedQty    Int
  targetSupplierId String?
  urgency         String   // LOW | MEDIUM | HIGH | CRITICAL
  reasoning       Json     // explanation payload: stock, velocity, lead time, projected stockout
  status          String   @default("PENDING") // PENDING | DRAFTED_PO | DISMISSED
  createdAt       DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, status])
}

model Alert {
  id                String   @id @default(uuid())
  type              String   // STOCKOUT_RISK | REORDER | DEMAND_ANOMALY | SUPPLIER_PERF | LEAD_TIME | PAYMENT_DUE | OVERDUE | SHIPMENT_DELAY | MARGIN | EXPIRY | DEAD_STOCK | BOM_SHORTAGE | CREDIT_LIMIT
  severity          String   // LOW | MEDIUM | HIGH | CRITICAL
  productId         String?
  supplierId        String?
  payload           Json     // structured data underlying the alert
  reasoning         String   // human-readable explanation
  status            String   @default("OPEN") // OPEN | ACKNOWLEDGED | SNOOZED | RESOLVED
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  snoozedUntil      DateTime?
  createdAt         DateTime @default(now())

  acknowledgedBy User? @relation(fields: [acknowledgedById], references: [id])

  @@index([status, severity, createdAt])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

// Append-only event log. Every state-changing action lands here.
model EventLog {
  id         String   @id @default(uuid())
  eventType  String   // PO_CREATED | PO_APPROVED | GOODS_RECEIVED | SHIPMENT_DISPATCHED | COGS_POSTED | etc.
  entityType String
  entityId   String
  actorId    String?
  payload    Json?
  sourceIp   String?
  occurredAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([occurredAt])
}
