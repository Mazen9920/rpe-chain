DATABASE_URL="postgresql://rpe_user:rpe_pass@localhost:5432/rpe_supply"
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development

# --- Section 9 — see root .env.example for full descriptions ---
STORAGE_DRIVER=local
STORAGE_BUCKET=rpe-chain
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@rpechain.local
MAIL_FROM_NAME=RPE Chain
SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_DEFAULT_WAREHOUSE_ID=
BOSTA_API_BASE=https://app.bosta.co/api/v2
BOSTA_API_KEY=
BOSTA_WEBHOOK_SECRET=
BOSTA_BUSINESS_LOCATION_ID=

# --- v1.7.1 OAuth integrations (GL Export real-push) ---
FRONTEND_ORIGIN=http://localhost:5173
# QuickBooks Online — leave QUICKBOOKS_CLIENT_ID blank to keep simulated push.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
# Optional overrides (defaults: Intuit prod auth, sandbox API):
# QBO_AUTH_URL=https://appcenter.intuit.com/connect/oauth2
# QBO_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
# QBO_API_BASE=https://sandbox-quickbooks.api.intuit.com
# Xero — leave XERO_CLIENT_ID blank to keep simulated push.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback
# Optional overrides:
# XERO_AUTH_URL=https://login.xero.com/identity/connect/authorize
# XERO_TOKEN_URL=https://identity.xero.com/connect/token
# XERO_API_BASE=https://api.xero.com
