# Copy to `.env` at the repo root for `docker compose up` overrides.
# Every value here is the default that docker-compose.yml falls back to.

# --- Postgres ---
POSTGRES_USER=rpe_user
POSTGRES_PASSWORD=rpe_pass
POSTGRES_DB=rpe_supply

# --- Backend ---
DATABASE_URL=postgresql://rpe_user:rpe_pass@postgres:5432/rpe_supply
JWT_SECRET=dev-only-change-me-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
NODE_ENV=production
LOG_LEVEL=info
RUN_DAILY_ON_BOOT=false
DISABLE_SCHEDULER=false
RATE_LIMIT_DISABLED=false
SEED_ON_BOOT=false

# --- Observability (optional; leave blank to disable) ---
SENTRY_DSN=

# --- pgAdmin (only used with `--profile tools`) ---
PGADMIN_EMAIL=admin@rpegear.com
PGADMIN_PASSWORD=admin

# --- Section 9 — Storage (MinIO/S3) ---
STORAGE_DRIVER=s3            # s3 | local
STORAGE_BUCKET=rpe-chain
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Section 9 — Mail (SendGrid primary, SMTP fallback) ---
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=no-reply@rpechain.local
MAIL_FROM_NAME=RPE Chain

# --- Section 9 — Shopify ---
SHOPIFY_SHOP=                # e.g. mystore.myshopify.com
SHOPIFY_ADMIN_TOKEN=         # custom-app admin API access token
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_DEFAULT_WAREHOUSE_ID=

# --- Section 9 — Bosta ---
BOSTA_API_BASE=https://app.bosta.co/api/v2
BOSTA_API_KEY=
BOSTA_WEBHOOK_SECRET=
BOSTA_BUSINESS_LOCATION_ID=
