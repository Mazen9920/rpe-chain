# Copy to `.env` at the repo root for `docker compose up` overrides.
# Every value here is the default that docker-compose.yml falls back to.

# --- Postgres ---
POSTGRES_USER=rpe_user
POSTGRES_PASSWORD=rpe_pass
POSTGRES_DB=rpe_supply

# --- Backend ---
DATABASE_URL=postgresql://rpe_user:rpe_pass@postgres:5432/rpe_supply
JWT_SECRET=dev-only-change-me-please
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
NODE_ENV=production
LOG_LEVEL=info
RUN_DAILY_ON_BOOT=false
DISABLE_SCHEDULER=false
RATE_LIMIT_DISABLED=false
SEED_ON_BOOT=false

# --- Observability (optional; leave blank to disable) ---
SENTRY_DSN=

# --- pgAdmin (only used with `--profile tools`) ---
PGADMIN_EMAIL=admin@rpegear.com
PGADMIN_PASSWORD=admin
