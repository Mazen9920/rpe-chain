{
  "expo": {
    "name": "RPE Chain",
    "slug": "rpe-chain",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rpesupply",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rpegear.supply"
    },
    "android": {
      "package": "com.rpegear.supply"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
